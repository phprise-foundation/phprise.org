---
import TaxonomyBadge from './TaxonomyBadge.astro';

interface Props {
  project: {
    slug: string;
    package: string | null;
    title: string;
    summary: string;
    taxonomy: string;
    kind: string;
    url: string | null;
    stars: number | null;
    deprecated?: boolean;
    replacedBy?: string | null;
  };
}

const { project } = Astro.props;
const replacement = project.replacedBy
  ? `/projects/${project.replacedBy.split('/').pop()}`
  : null;
---

<article
  class:list={['card', { 'card--deprecated': project.deprecated }]}
  data-taxonomy={project.taxonomy}
  data-search={`${project.title} ${project.summary} ${project.package ?? ''}`.toLowerCase()}
>
  <header class="card__head">
    <h3 class="card__title"><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
    <span class="card__badges">
      {project.deprecated && <span class="badge badge--deprecated">Deprecated</span>}
      <TaxonomyBadge taxonomy={project.taxonomy} />
    </span>
  </header>

  <p class="card__body">{project.summary}</p>

  <footer class="card__foot">
    {project.deprecated && replacement ? (
      <span>Replaced by <a href={replacement}>{project.replacedBy}</a></span>
    ) : (
      project.package && <span class="card__pkg">{project.package}</span>
    )}
    {project.stars !== null && project.stars > 0 && (
      <span aria-label={`${project.stars} stars on GitHub`}>★ {project.stars}</span>
    )}
  </footer>
</article>
