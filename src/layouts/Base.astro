---
import '../styles/main.css';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path } = Astro.props;

const rawPath = path ?? Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '/' : rawPath.replace(/\/?$/, '/');
const canonical = new URL(normalizedPath, Astro.site);
const fullTitle = path === '/' || path === undefined
  ? `${title}`
  : `${title} — PHPRise`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PHPRise" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">P</span>
          <span>phprise</span>
        </a>

        <nav class="nav" aria-label="Main">
          <a href="/projects" aria-current={Astro.url.pathname.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="/manifesto" aria-current={Astro.url.pathname === '/manifesto' ? 'page' : undefined}>Manifesto</a>
          <a href="/contribute" aria-current={Astro.url.pathname === '/contribute' ? 'page' : undefined}>Contribute</a>
          <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a>
          <a href="https://github.com/phprise-foundation" rel="noopener">GitHub&nbsp;↗</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div>
          <a class="brand" href="/">
            <span class="brand__mark" aria-hidden="true">P</span>
            <span>phprise</span>
          </a>
          <p class="site-footer__note">
            Open source PHP, built under constraint.
          </p>
        </div>

        <nav class="footer-nav" aria-label="Footer">
          <a href="/projects">Projects</a>
          <a href="/manifesto">Manifesto</a>
          <a href="/contribute">Contribute</a>
          <a href="/about">About</a>
          <a href="https://github.com/phprise-foundation" rel="noopener">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
